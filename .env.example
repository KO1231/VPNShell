# VPNShell の設定 (機密ではない値だけを書く)
# 通常は `vpnsh setup --import <NordVPN の .conf>` が自動で作成・更新します。
# WireGuard の秘密鍵はここには書きません (macOS キーチェーンに保存されます)。

# --- NordVPN 専用IPサーバー (Nord Account の Dedicated IP タブでダウンロードした .conf の値) ---
# [Peer] Endpoint の IP (ホスト名は不可)
WIREGUARD_ENDPOINT_IP=203.0.113.10
# [Peer] Endpoint のポート
WIREGUARD_ENDPOINT_PORT=51820
# [Peer] PublicKey (サーバーの公開鍵。44文字)
WIREGUARD_PUBLIC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# [Interface] Address (IPv4 のみ)
WIREGUARD_ADDRESSES=10.5.0.2/32
# MTU (通常は変更不要。ハングする場合に下げる)
WIREGUARD_MTU=1320

# --- 照合する専用IP (初回の setup で、観測値を確認してから確定します) ---
EXPECTED_PUBLIC_IP=203.0.113.10
