#!/usr/bin/perl
use strict;
use warnings;
no warnings 'uninitialized';
use IO::Socket::UNIX;
use IO::Select;
use IPC::Open2;
use Socket qw(SOCK_STREAM);
use Errno qw(EAGAIN EWOULDBLOCK EINTR);
use POSIX qw(strftime);
use Time::HiRes ();

my ($cid, $agent, $context, $audit) = @ARGV;
die "usage: ssh-relay <container> <agent-socket> <context> [audit-log]\n" unless $cid && $agent && $context;
die "ssh-relay: bad container id\n" unless $cid =~ /\A[0-9a-f]{12,64}\z/;
die "ssh-relay: bad context\n" unless $context =~ /\A[A-Za-z0-9._-]+\z/;
my $MAX = 262144;         # ssh-agent のメッセージの上限 (256KiB)
my $MAX_CONN = 32;        # 1シェルあたりの同時接続数の上限
my $WRITE_TIMEOUT = 10;
my %ALLOW = (11 => 1, 13 => 1);    # 27 (拡張) は名前を見て判断する
my $LOG_FIRST = 10;       # 1本の中継で、拒否を1件ずつ記録する件数 (それ以降はまとめる)
my $LOG_EVERY = 60;       # まとめた件数を記録する間隔 (秒)
my $DENY_MAX = 1000;      # 1本の中継で拒否がこれを超えたら、中継を終える
my $AUDIT_MAX = 1048576;  # 記録ファイルがこれを超えたら、1世代だけ残して入れ替える
my ($denied, $suppressed, $last_summary) = (0, 0, time);
my $SESSION_BIND = 'session-bind@openssh.com';
# 署名の失敗が直近 $SIGN_FAIL_WINDOW 秒で $SIGN_FAIL_MAX 回、または累計 $SIGN_FAIL_TOTAL 回に達したら中継を終える
my $SIGN_FAIL_MAX = 3;
my $SIGN_FAIL_WINDOW = 300;
my $SIGN_FAIL_TOTAL = 5;
my $SIGN_SLOW = 1;        # 応答までこの秒数以上かかった失敗は、確認ダイアログが出たものとみなす
my @sign_fail;            # 署名が失敗した時刻 (直近 $SIGN_FAIL_WINDOW 秒の分だけ残す)
my $sign_fail_total = 0;

# docker exec の stderr (コンテナ側の警告など) は端末に出さない
open(STDERR, '>', '/dev/null');
my $pid = open2(my $from, my $to, 'docker', '--context', $context,
	'exec', '-i', $cid, '/usr/local/lib/vpnsh/ssh-relay')
	or exit 1;
binmode $from;
binmode $to;
$SIG{PIPE} = 'IGNORE';
my $done = sub { kill 'TERM', $pid; exit 0; };
$SIG{TERM} = $done;
$SIG{HUP} = $done;
$SIG{INT} = $done;

my $sel = IO::Select->new($from);
my (%conn, %id_of, %req);    # %req: 接続ごとの、コンテナから来た未処理のバイト列
# 接続ごとの、応答待ちの要求の種類・未処理の応答・署名を送った時刻・session-bind の成否
my (%pend, %resp, %sent13, %bound);
my $inflight13;    # 署名の応答を待っている接続の番号 (中継全体で1件まで)
my @wait13;        # 署名の要求を送る順番を待っている接続の番号 (来た順)
my $inbuf = '';

sub audit {
	return unless $audit;
	my @st = stat($audit);
	rename($audit, "$audit.1") if @st && $st[7] > $AUDIT_MAX;
	if (open(my $fh, '>>', $audit)) {
		printf $fh "%s\t%s\t-\t-\n", strftime('%Y-%m-%dT%H:%M:%SZ', gmtime), $_[0];
		close $fh;
	}
}
sub write_all {
	my ($fh, $buf) = @_;
	my $ws = IO::Select->new($fh);
	while (length $buf) {
		return 0 unless $ws->can_write($WRITE_TIMEOUT);
		my $n = syswrite($fh, $buf);
		if (!defined $n) { next if $! == EINTR || $! == EAGAIN || $! == EWOULDBLOCK; return 0; }
		substr($buf, 0, $n, '');
	}
	return 1;
}
sub send_frame {
	my ($t, $id, $d) = @_;
	$d = '' unless defined $d;
	write_all($to, pack('a1NN', $t, $id, length $d) . $d) or $done->();
}
sub close_conn {
	my ($id, $notify) = @_;
	# 応答を待っている署名の要求は、失敗として数える (片付けてから数える。数えた結果で中継を終えることがあるため)
	my $unanswered = grep { $_ == 13 } unpack('C*', $pend{$id} // '');
	delete $req{$id};
	delete $pend{$id};
	delete $resp{$id};
	delete $sent13{$id};
	delete $bound{$id};
	my $c = delete $conn{$id};
	if ($c) {
		delete $id_of{fileno $c} if defined fileno $c;
		$sel->remove($c);
		close $c;
		send_frame('C', $id) if $notify;
	}
	@wait13 = grep { $_ != $id } @wait13;
	sign_failed('closed-before-response') for 1 .. $unanswered;
	release13() if defined $inflight13 && $inflight13 == $id;
}

# release13  署名の応答が返った (またはその接続が閉じた) ので、待たせている接続の署名の要求を来た順に送る
sub release13 {
	undef $inflight13;
	while (!defined $inflight13 && @wait13) {
		my $id = shift @wait13;
		filter_requests($id) if $conn{$id};
	}
}

# deny <番号> <種類>  失敗 (SSH_AGENT_FAILURE) を返してその接続を閉じ、件数を絞って記録する
sub deny {
	my ($id, $type) = @_;
	send_frame('D', $id, pack('NC', 1, 5));
	close_conn($id, 1);
	$denied++;
	if ($denied <= $LOG_FIRST) {
		audit("deny(relay:type=$type)");
	} else {
		$suppressed++;
		if (time - $last_summary >= $LOG_EVERY) {
			audit("deny(relay:$suppressed more)");
			($suppressed, $last_summary) = (0, time);
		}
	}
	if ($denied > $DENY_MAX) {
		audit("deny(relay:too-many;" . ($suppressed ? "$suppressed more;" : "") . "relay-stopped)");
		$done->();
	}
}

# filter_requests <番号>  溜まったバイト列から完全なメッセージを取り出し、許可するものだけ専用 ssh-agent へ送る
sub filter_requests {
	my ($id) = @_;
	my $c = $conn{$id} or return;
	while (length($req{$id}) >= 4) {
		my $len = unpack('N', $req{$id});
		if ($len < 1 || $len > $MAX) { close_conn($id, 1); return; }
		last if length($req{$id}) < 4 + $len;
		# 別の署名の応答を待っている間は、この接続の署名の要求 (と、その後ろの要求) を送らずに待たせる
		if (ord(substr($req{$id}, 4, 1)) == 13 && defined $inflight13) {
			push @wait13, $id unless grep { $_ == $id } @wait13;
			last;
		}
		my $msg = substr($req{$id}, 0, 4 + $len, '');
		my $type = ord(substr($msg, 4, 1));
		my $ok = $ALLOW{$type};
		if (!$ok && $type == 27 && $len >= 5) {
			my $nlen = unpack('N', substr($msg, 5, 4));
			$ok = 1 if $nlen == length($SESSION_BIND) && substr($msg, 9, $nlen) eq $SESSION_BIND;
		}
		if ($ok) {
			$pend{$id} .= chr($type);
			if ($type == 13) {
				push @{$sent13{$id}}, Time::HiRes::time();
				$inflight13 = $id;
			}
			write_all($c, $msg) or do { close_conn($id, 1); return; };
		} else {
			deny($id, $type);
			return;
		}
	}
}

# sign_failed <理由>  署名の失敗を数え、上限に達したら中継を終える
sub sign_failed {
	my ($why) = @_;
	my $now = time;
	@sign_fail = grep { $now - $_ < $SIGN_FAIL_WINDOW } @sign_fail;
	push @sign_fail, $now;
	$sign_fail_total++;
	audit("deny(relay:sign-failed;$why;" . scalar(@sign_fail) . "/$SIGN_FAIL_MAX in ${SIGN_FAIL_WINDOW}s;total $sign_fail_total/$SIGN_FAIL_TOTAL)");
	if (@sign_fail >= $SIGN_FAIL_MAX || $sign_fail_total >= $SIGN_FAIL_TOTAL) {
		audit("deny(relay:sign-failed-too-often;relay-stopped)");
		$done->();
	}
}

# watch_responses <番号> <データ>  専用 ssh-agent の応答を読み、署名 (13) の失敗 (5) を数える (転送はしない)
sub watch_responses {
	my ($id, $b) = @_;
	return unless exists $resp{$id};
	$resp{$id} .= $b;
	my $answered13 = 0;
	while (length($resp{$id}) >= 4) {
		my $len = unpack('N', $resp{$id});
		# 専用 ssh-agent が壊れた応答を返すことは無いはずだが、念のため中継を終える (数えられない状態で続けない)
		if ($len < 1 || $len > $MAX) { audit("deny(relay:bad-agent-response;relay-stopped)"); $done->(); }
		last if length($resp{$id}) < 4 + $len;
		my $rtype = ord(substr($resp{$id}, 4, 1));
		substr($resp{$id}, 0, 4 + $len, '');
		my $qtype = length($pend{$id}) ? ord(substr($pend{$id}, 0, 1, '')) : 0;
		if ($qtype == 27) {
			$bound{$id} = 1 if $rtype == 6;    # session-bind の成功 (SSH_AGENT_SUCCESS)
		} elsif ($qtype == 13) {
			my $t0 = shift @{$sent13{$id}};
			$answered13 = 1;
			next unless $rtype == 5;
			# 接続先に縛った鍵は、session-bind の無い接続ではダイアログを出す前に断られる (ダイアログの出ない失敗は数えない)
			if ($bound{$id}) { sign_failed('refused'); }
			elsif (Time::HiRes::time() - $t0 >= $SIGN_SLOW) { sign_failed('refused-unbound'); }
		}
	}
	# 数え終わってから、待たせている署名の要求を送る
	release13() if $answered13 && defined $inflight13 && $inflight13 == $id;
}

while (1) {
	for my $fh ($sel->can_read) {
		next unless defined fileno $fh;
		if ($fh == $from) {
			my $n = sysread($from, my $b, 65536);
			$done->() unless $n;
			$inbuf .= $b;
			while (length($inbuf) >= 9) {
				my ($t, $id, $len) = unpack('a1NN', $inbuf);
				$done->() if $len > $MAX;
				last if length($inbuf) < 9 + $len;
				my $d = substr($inbuf, 9, $len);
				substr($inbuf, 0, 9 + $len, '');
				if ($t eq 'O') {
					# 同じ番号が2回来るのは異常なので中継を終える
					$done->() if exists $conn{$id};
					if (keys(%conn) >= $MAX_CONN) { send_frame('C', $id); next; }
					my $c = IO::Socket::UNIX->new(Type => SOCK_STREAM, Peer => $agent);
					if (!$c) { send_frame('C', $id); next; }
					$c->blocking(0);
					$conn{$id} = $c;
					$id_of{fileno $c} = $id;
					$req{$id} = '';
					$pend{$id} = '';
					$resp{$id} = '';
					$sent13{$id} = [];
					$sel->add($c);
				}
				elsif ($t eq 'D') {
					next unless $conn{$id};
					$req{$id} .= $d;
					if (length($req{$id}) > $MAX + 4) { close_conn($id, 1); next; }
					filter_requests($id);
				}
				elsif ($t eq 'C') {
					close_conn($id, 0);
				}
				else {
					$done->();
				}
			}
		}
		else {
			my $id = $id_of{fileno $fh};
			next unless defined $id;
			my $n = sysread($fh, my $b, 65536);
			if (!defined $n) { next if $! == EAGAIN || $! == EWOULDBLOCK || $! == EINTR; close_conn($id, 1); }
			elsif ($n == 0) { close_conn($id, 1); }
			else { send_frame('D', $id, $b); watch_responses($id, $b); }
		}
	}
}
